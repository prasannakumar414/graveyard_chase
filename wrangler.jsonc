{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "afterhours-arcade",
    "compatibility_date": "2026-11-06",
    "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
    },
    "routes": [
        { "pattern": "afterhours.goredlap.com", "custom_domain": true }
    ]
}
